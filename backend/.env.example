# OpenAI key used by ai_service
OPENAI_API_KEY=sk-...

# Secret used to sign JWTs — generate a long random string in production
JWT_SECRET_KEY=change-me

# SQLAlchemy connection string.
# Local dev: sqlite:///learntube.db
# Railway + Postgres: postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///learntube.db

# Comma-separated list of allowed origins for CORS.
# Local dev: http://localhost:3000
# Production: https://<your-app>.vercel.app,https://<your-app>-git-main-<user>.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
